# Huntloan — environment template
# Matches variables used in Bitcoin-Sentinel/eth_forensics/.env
# Copy to .env and fill in. NEVER commit .env to git.

# ── RPC ────────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Wallet ─────────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Contracts ──────────────────────────────────────────────────────────────
# Active flash liquidator V2 (deployed 2026-02-28, Base mainnet)
EXECUTOR_ADDRESS=0xE5c3e80C243A6E21883E787013254BeAC829AD1E

# New Huntloan.sol — set after forge deploy
HUNTLOAN_CONTRACT=0x0000000000000000000000000000000000000000

# ── Telegram alerts ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Bot settings ────────────────────────────────────────────────────────────
DRY_RUN=false
MIN_PROFIT_USD=10
WATCHLIST_PATH=../Bitcoin-Sentinel/eth_forensics/simulation/watchlist.json

# ── Logging ────────────────────────────────────────────────────────────────
RUST_LOG=huntloan=info
