# HuntLoan — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# [NETWORK]
# HTTP RPC endpoint for Base mainnet (Alchemy / QuickNode / Infura recommended)
RPC_URL=https://mainnet.base.org
# WebSocket endpoint — REQUIRED for event-driven block subscription (WS scanner)
WS_RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Private RPC for transaction submission — when set, txs are sent here instead of
# RPC_URL, keeping them out of the public mempool (Base MEV protection).
# Use Alchemy's sendPrivateTransaction endpoint or a private sequencer RPC.
# PRIVATE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# [WALLET]
# Operator private key — signs and broadcasts liquidation transactions
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# [CONTRACTS]
# Deployed HuntLoanFlashReceiver contract address (set after forge deploy)
HUNTLOAN_CONTRACT=0x0000000000000000000000000000000000000000
# Aave V3 Pool on Base mainnet (canonical — do not change)
AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# Aave V3 PoolAddressesProvider on Base (used for flash loan init)
AAVE_ADDRESSES_PROVIDER=0xe20fCBdBfFC4Dd138cE8b2E6FBb6CB49777ad64D

# [TELEGRAM]
# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Telegram chat ID for alert delivery
TELEGRAM_CHAT_ID=your_chat_id_here

# [BOT SETTINGS]
# Path to watchlist JSON (array of addresses or objects with .address field)
WATCHLIST_PATH=../Bitcoin-Sentinel/eth_forensics/simulation/watchlist.json
# Set to true to simulate only — no transactions will be broadcast
DRY_RUN=false
# Minimum net profit in USD to execute a liquidation
MIN_PROFIT_USD=10
# Maximum gas cost cap in wei (default 0.008 ETH = 8_000_000_000_000_000)
MAX_GAS_COST_WEI=8000000000000000
# Maximum sequencer bribe in wei (default 0.05 ETH = 50_000_000_000_000_000)
MAX_BRIBE_WEI=50000000000000000

# [LOGGING]
# RUST_LOG filter — huntloan=info shows key events; huntloan=debug shows all
RUST_LOG=huntloan=info
