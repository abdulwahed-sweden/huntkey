# Huntloan — environment template
# Copy to .env and fill in real values. Never commit .env to git.

# RPC endpoints (Base mainnet)
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Operator wallet — signs and sends transactions, pays gas
OPERATOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract address (set after: forge create or hardhat deploy)
HUNTLOAN_CONTRACT=0x0000000000000000000000000000000000000000

# Optional overrides (defaults to Aave V3 Base addresses)
# AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# AAVE_PROVIDER=0xe20fCBdBfFC4Dd138cE8b2E6FBb6CB49777ad64D

# Bot settings
MIN_PROFIT_USD=50
RUST_LOG=huntloan=info
