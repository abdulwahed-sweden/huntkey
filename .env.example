# HuntLoan — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# [NETWORK]
# HTTP RPC endpoint for Base mainnet (Alchemy / QuickNode / Infura recommended)
RPC_URL=https://mainnet.base.org
# WebSocket endpoint — REQUIRED for event-driven block subscription (WS scanner)
WS_RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Private RPC for tx submission — keeps txs out of the public mempool (MEV protection).
# PRIVATE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# [WALLET]
# Operator private key — signs and broadcasts liquidation transactions
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# [CONTRACTS]
# Deployed HuntLoanFlashReceiver contract address (set after forge deploy)
HUNTLOAN_CONTRACT=0x0000000000000000000000000000000000000000
# Aave V3 Pool on Base mainnet (canonical — do not change)
AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# [TELEGRAM]
# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Telegram chat ID for alert delivery
TELEGRAM_CHAT_ID=your_chat_id_here

# [BOT SETTINGS]
# Path to watchlist JSON (array of addresses or objects with .address field)
WATCHLIST_PATH=watchlist.json
# Set to true to simulate only — no transactions will be broadcast
DRY_RUN=true
# Sign + print full tx preview, do NOT broadcast. Requires DRY_RUN=false.
SOFT_LIVE=false
# Minimum net profit in USD to execute (net of gas + flash premium)
MIN_PROFIT_USD=10
# Maximum gas cost cap in wei (default 0.008 ETH)
MAX_GAS_COST_WEI=8000000000000000
# Maximum sequencer bribe in wei (default 0.05 ETH)
MAX_BRIBE_WEI=50000000000000000

# [CIRCUIT BREAKER]
# Stop engine after N consecutive execution reverts
MAX_CONSECUTIVE_REVERTS=3
# Stop engine after N consecutive RPC errors
MAX_RPC_ERRORS=10

# ─────────────────────────────────────────────────────────────────────────────
# NEW KNOBS (Predator-grade upgrade — Phases 1–6)
# ─────────────────────────────────────────────────────────────────────────────

# [ALERTS] — Phase 1
# Minimum seconds between Telegram alerts of the same category (FAILED, CIRCUIT).
# 0 = unlimited. EXECUTED alerts are always sent (never rate-limited per tx).
ALERT_RATE_LIMIT_SECONDS=60

# Seconds between hourly/daily summary alerts (📊 ملخص الذئاب).
SUMMARY_INTERVAL_SECONDS=3600

# [EXECUTION FILTERS] — Phase 2
# Execute only if HF <= this value.
#   1.0 = disabled (default — execute all positions under HF 1.0)
#   0.90 = aggressive (skip positions barely underwater)
#   0.85 = strict (only deep distress positions)
STRONG_HF_THRESHOLD=1.0

# Minimum profit margin as basis points of debt (profit/debt × 10000).
#   Default 50 bps = 0.5%. Filters thin-margin positions.
MIN_MARGIN_BPS=50

# Hard daily gas spend cap in wei. Disabled by default (unlimited).
# Example: 20_000_000_000_000_000 = 0.02 ETH daily gas cap.
# MAX_DAILY_GAS_WEI=20000000000000000

# Hard daily bribe spend cap in wei. Disabled by default.
# Example: 100_000_000_000_000_000 = 0.1 ETH daily bribe cap.
# MAX_DAILY_BRIBE_WEI=100000000000000000

# [SPEED] — Phase 3
# Maximum concurrent on-chain eth_call simulation tasks (JoinSet concurrency).
#   Default 4. Increase to 8 for faster coverage, reduce if RPC rate-limits fire.
MAX_PARALLEL_SIMS=4

# Seconds a failed execution target is blacklisted before retrying.
#   Default 300s (5 min). Set lower for fast-moving markets.
TARGET_COOLDOWN_SECONDS=300

# [MICRO-BANKROLL SURVIVAL] — use these when wallet balance is low
# Slippage buffer: reduce expected gross by N bps before post-sim profit check.
#   Protects against price drift between eth_call simulation and actual broadcast.
#   0 = disabled (default). 2500 = 25% haircut (recommended for small bankroll).
# SLIPPAGE_BUFFER_BPS=2500

# Minimum wallet ETH balance (wei) required before any broadcast is attempted.
#   Default: 5_000_000_000_000_000 (0.005 ETH floor — ~2 tx headroom at 0.002 ETH gas cap).
#   Prevents executing into dust. Increase to 10_000_000_000_000_000 (0.01 ETH) for safety.
# MIN_WALLET_ETH_WEI=5000000000000000

# [LOGGING]
# RUST_LOG filter — huntloan=info shows key events; huntloan=debug shows all
RUST_LOG=huntloan=info
